{
  "design_id": "NEURAL-TM-1.0",
  "date": "2026-10-01",
  "status": "specified_not_implemented_not_frozen",
  "planned_protocol_tag": "protocol-v6.0.1",
  "runtime_config": false,
  "authority": "docs/NEURAL_ENCODER_EXPERIMENT_PROTOCOL.md",
  "owner_objective": "Determine how faithfully rules expressed in clinical concepts reproduce the neural classifier's decisions.",
  "heldout_exposure": "unknown_requires_conservative_audit",
  "primary": {
    "encoder_required": true,
    "mri_backbone_training_required": true,
    "representation": "trained_encoder_patient_bottleneck_64",
    "transition": "typed_affine_ridge_from_same_checkpoint_activations_to_measured_concepts",
    "consequent": "same_neural_classifier_argmax",
    "measured_concepts_at_inference": false,
    "expert_masks_as_neural_input": false,
    "acquisition_geometry_as_neural_input": true,
    "inference_qc": "image_geometry_and_numerical_only_no_reference_mask_qc",
    "phase_order": ["ED", "ES"],
    "class_order": ["DCM", "HCM", "MINF", "NOR", "RV"]
  },
  "input": {
    "all_slices": true,
    "percentile_clip_per_phase": [1, 99],
    "in_plane_spacing_mm": 1.5,
    "size_pixels": [224, 224],
    "crop_pad": "physical_center_no_mask",
    "through_plane_interpolation": false,
    "channels": "grayscale_replicated_to_3",
    "channel_mean": [0.485, 0.456, 0.406],
    "channel_sd": [0.229, 0.224, 0.225],
    "slice_geometry": ["centered_z_mm_divided_by_100", "corrected_increment_mm_divided_by_10"]
  },
  "encoder": {
    "backbone": "torchvision_resnet18",
    "weights": "ResNet18_Weights.IMAGENET1K_V1",
    "weights_sha256": "resolve_and_pin_before_training",
    "slice_projection": [514, 128],
    "slice_activation": "GELU",
    "attention": [128, 64, 1],
    "attention_activation": "tanh_then_slice_softmax",
    "phase_pooling": "concatenated_attention_mean_and_max",
    "phase_combination": ["ED", "ES", "ED_minus_ES"],
    "bottleneck_layers": [768, 256, 64],
    "bottleneck_activation": "GELU_after_each_linear",
    "dropout_after_first_gelu": 0.25,
    "classifier": "Linear(64,5)",
    "batchnorm_running_statistics": "frozen_pretrained"
  },
  "training": {
    "primary_seed": 20261001,
    "robustness_seeds": [20261002, 20261003],
    "seed_selection": "forbidden",
    "ensemble": false,
    "candidate_unfrozen_blocks": [["layer4"], ["layer3", "layer4"]],
    "candidate_backbone_learning_rates": [0.00001, 0.00003, 0.0001],
    "new_layer_learning_rate_multiplier": 10,
    "loss": "fit_class_frequency_weighted_cross_entropy",
    "primary_concept_loss": false,
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "epsilon": 1e-8,
    "gradient_norm_clip": 5,
    "effective_patient_batch_size": 4,
    "max_epochs": 80,
    "minimum_epochs_before_stopping": 20,
    "early_stopping_patience": 12,
    "early_stopping_min_improvement": 0.0001,
    "early_stopping_metric": "validation_cross_entropy",
    "schedule": "cosine_over_80_epochs",
    "final_epoch_count": "ceil_median_selected_inner_epochs",
    "precision": "FP32",
    "deterministic_algorithms": true,
    "augmentation": {
      "rotation_degrees": [-10, 10],
      "translation_mm_each_axis": [-10, 10],
      "intensity_multiplier": [0.9, 1.1],
      "noise_sd": 0.01,
      "shared_spatial_transform_across_phases_slices": true
    },
    "candidate_selection_order": ["mean_macro_f1_desc", "mean_cross_entropy_asc", "unfrozen_block_count_asc", "learning_rate_asc"]
  },
  "validation": {
    "outer_assessment_folds": 5,
    "rule_gate_folds": 5,
    "selection_folds": 3,
    "resampling_unit": "cluster_id",
    "split_salt": "neural-tm-v1",
    "encoder_retrained_within_each_assessment_boundary": true,
    "mix_fold_latent_coordinates": false,
    "development_gate_intervals": "nominal_selection_not_independent_confirmation",
    "evaluate_only_after_protocol_and_bundle_freezes": true
  },
  "semantics_and_rules": {
    "registry_inheritance": "protocol-v6.0.0:registry/semantic_registry.yaml",
    "transition_inheritance": "protocol-v6.0.0:configs/transition.yaml",
    "wedd_profile_inheritance": "protocol-v6.0.0:configs/wedd.yaml#profiles.wedd_gaussian_mm_v1",
    "concept_availability_min": 0.8,
    "concept_distinct_values_min": 3,
    "concept_mae_relative_improvement_min": 0.05,
    "concept_improved_gate_folds_min": 4,
    "concept_improved_selection_folds_min": 2,
    "cut_bootstrap_replicates": 500,
    "cut_recurrence_min": 0.6,
    "vprs_beta": 0.1,
    "discovery_confidence_min": 0.9,
    "discovery_support_min": 5,
    "rule_max_length": 3,
    "rule_cap": null,
    "development_oof_rule_matches_min": 10,
    "development_rule_wilson_lower_min": 0.7,
    "development_rule_reproduced_folds_min": 3,
    "inference_stability_pairs": 5,
    "inference_stability_votes_min": 4,
    "strict_semantic_support": "all_antecedents_of_all_consistent_fired_rules_observed_and_same_reference_bin",
    "independent_rule_matches_min": 20,
    "independent_rule_fidelity_min": 0.9,
    "independent_rule_fidelity_simultaneous_lower_min": 0.8,
    "independent_rule_semantics_simultaneous_lower_min": 0.7,
    "rule_simultaneous_family": "two_proportions_per_frozen_rule_bonferroni"
  },
  "success": {
    "G0": "all_provenance_and_exposure_checks_pass",
    "G1": {"macro_f1_min": 0.7, "macro_f1_lower_min": 0.6, "balanced_accuracy_min": 0.7},
    "G2": {"primary_targets_estimable_min": 5, "rho_min": 0.1, "rho_lower_strictly_above": 0},
    "G3": {"coverage_min": 0.5, "coverage_lower_min": 0.4, "fidelity_min": 0.9, "fidelity_lower_min": 0.85, "accepted_clusters_min": 30},
    "G4": {"semantic_support_min": 0.85, "semantic_support_lower_min": 0.75, "faithful_semantic_coverage_min": 0.35, "faithful_semantic_coverage_lower_min": 0.25},
    "G5": {"head_residual_energy_fraction_max": 0.1, "projected_head_agreement_min": 0.95, "projected_head_agreement_lower_min": 0.9, "projector_relative_svd_tolerance": 1e-10},
    "logic": "G0_and_G1_and_G2_and_G3_and_G4_and_G5",
    "unknown_or_ne_passes": false
  },
  "statistics": {
    "ci_level": 0.95,
    "singleton_proportion_interval": "two_sided_Wilson",
    "bootstrap_replicates": 10000,
    "bootstrap_seed": 20261011,
    "undefined_bootstrap_fraction_max": 0.05,
    "subgroup_ci_min_clusters": 20,
    "secondary_superiority_contrasts": ["primary_vs_tertile_semtra", "primary_vs_selective_CART"],
    "secondary_effect_min": 0.05,
    "secondary_adjustment": "Holm_two_tests_after_primary_gates",
    "cluster_sign_flip_draws": 100000,
    "design_sensitivity_N": [50, 100, 220],
    "design_sensitivity_coverage": [0.3, 0.5, 0.7],
    "design_sensitivity_fidelity": [0.9, 0.95, 0.98],
    "design_sensitivity_semantic_support": [0.8, 0.9, 0.95]
  },
  "data_location": {
    "default": "owner_workstation_only",
    "cloud_exception": "CPE-1",
    "storage_exception": "CSE-1: unopened original MnM2.rar in off-site storage; storage only; staging reads the D: copy",
    "amendment": "protocol/amendments.md 2026-10-02",
    "cloud_workspace": "modal_personal_workspace_<workspace>_owner_only_member",
    "cloud_volumes": ["tmmri-neural-cache", "tmmri-neural-runs"],
    "cloud_permitted": ["acdc_dev_preprocessed_slice_tensors", "acdc_dev_slice_geometry_scalars", "acdc_dev_class_labels", "acdc_dev_locally_computed_concept_targets", "development_fit_outputs", "synthetic_tensors"],
    "never_uploaded": ["raw_acdc_release_files_and_masks", "acdc_height_and_weight", "acdc_test", "mms1_any_file_or_derivative", "mms2_any_file_or_derivative", "clinical_validation", "v6_run_roots"],
