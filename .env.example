# Host paths and limits for compose.yaml (docs/EXECUTION_ENVIRONMENT_SPEC.md 1.0.0, Section 9).
# Copy to .env (git-ignored) and adjust. Forward slashes; relative paths resolve from the repository root.
# ACDC release, bound read-only at /sources/acdc (default: the repository's git-ignored raw copy)
TMMRI_ACDC_SOURCE=./data/raw/acdc/database
# Complete M&Ms-1 release, bound read-only at /sources/mms (Research Use Agreement: never copied or redistributed)
TMMRI_MMS_SOURCE=<path to the complete M&Ms-1 release>
# Archive folder, bound at /archive (environment records, image tarballs, backups); must exist before any compose command
TMMRI_ARCHIVE=<path to an existing archive folder>
# CPU cap for each tmmri container (16 logical CPUs on this host; lower it while a CXR-TRANS-AUDIT job runs)
TMMRI_CPUS=14
