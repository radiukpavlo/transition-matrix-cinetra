# Container runtime variables, loaded by Compose `env_file` (docs/EXECUTION_ENVIRONMENT_SPEC.md 1.0.0, Appendix C).
# Fixed hash seed: set/dict iteration order must not vary between runs (replay boundary, SPECIFICATION.md 6.0.0)
PYTHONHASHSEED=0
# UTF-8 file and console I/O regardless of locale (registry, manifests and reports are UTF-8)
PYTHONUTF8=1
# One OpenMP/BLAS/numexpr thread per process: parallelism is per case across joblib workers (Decision D3),
# which keeps results independent of the worker count and avoids oversubscribing the CPUs
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
# Per-case worker processes: 12 of the 14 CPUs the container may use (TMMRI_CPUS), leaving room for the parent and I/O
TMMRI_N_JOBS=12
# Project root inside the container: the bind-mounted checkout
TMMRI_PROJECT_ROOT=/workspace
# Runtime data root: named volume tmmri_data (staging cache, manifests); raw sources stay in read-only binds
TMMRI_DATA_ROOT=/workspace/data
# Run outputs: named volume tmmri_artifacts, one folder per run id
TMMRI_ARTIFACT_ROOT=/workspace/artifacts
# Read-only source binds: /sources/acdc and /sources/mms
TMMRI_SOURCES_ROOT=/sources
# Headless figures (no display in the container)
MPLBACKEND=Agg
